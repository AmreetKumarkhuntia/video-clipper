{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/app/web/**/*.svelte",
    "src/app/web/**/*.ts",
    "src/lib/**/*.ts",
    "vite.config.ts"
  ]
}
