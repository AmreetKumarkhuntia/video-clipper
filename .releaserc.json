{
  "branches": ["master"],
  "tagFormat": "vdclip-v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CLI_CHANGELOG.md",
        "changelogTitle": "# vdclip changelog"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false,
        "pkgRoot": "artifacts/cli"
      }
    ],
    "./artifacts/release/cliRelease.mjs",
    [
      "@semantic-release/git",
      {
        "assets": ["CLI_CHANGELOG.md"],
        "message": "chore(release): vdclip ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ]
}
